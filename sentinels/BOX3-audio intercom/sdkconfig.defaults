# =====================================================================
# Target / flash / PSRAM
# =====================================================================
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# =====================================================================
# RTOS / partitions / fonts / FAT
# =====================================================================
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_FATFS_LFN_HEAP=y

# =====================================================================
# FreeRTOS / PSRAM stacks
# =====================================================================
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# =====================================================================
# mbedTLS / MQTT — push memory to PSRAM, allocate on demand
# =====================================================================
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MQTT_BUFFER_SIZE=4096
CONFIG_MQTT_OUTBOX_DATA_ON_EXTERNAL_MEMORY=y
# TLS inbound MUST be 16384 to accept full-size TLS records from cloud brokers.
# Outbound can stay small because *we* control what we send.

# =====================================================================
# WiFi: relationship enforced —  RX_BA_WIN (4) <= 2 * STATIC_RX (4) = 8
# =====================================================================
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=0
CONFIG_ESP_WIFI_AMSDU_TX_ENABLED=n
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# =====================================================================
# lwIP — smaller windows/mailboxes
# =====================================================================
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

# =====================================================================
# Internal heap reserve for DMA (AES, I2S, WiFi)
# =====================================================================
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304

# =====================================================================
# Build size
# =====================================================================
CONFIG_COMPILER_OPTIMIZATION_SIZE=y